# 复制为 .dev.vars 后填写（.dev.vars 已被 git 忽略，切勿提交真实密钥）
# 本地执行 npx wrangler dev 时使用

# Telegram Bot Token，来自 @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# 可选：固定推送会话 ID。留空则由首个与 bot 交互的会话自动绑定
# TELEGRAM_CHAT_ID=-1001234567890

# webhook 校验密钥，用于 /webhook 与 /setup 路由鉴权。
# 用 Deploy to Cloudflare 按钮部署时，这个文件里的键会作为待填项出现在部署页面。
WEBHOOK_SECRET=change-me
